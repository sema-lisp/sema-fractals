;; Three experimental complex recurrences, painted with splash.computer tokens.
(define root "./")
(define width 360)
(define height 274)
(define limit 65)
(define phase 0.0)
(define drift 0.0)
(define sway 0.0)
(define palette (list (list 10 10 11) (list 96 165 250) (list 34 211 238)
                     (list 185 155 224) (list 250 204 21) (list 253 224 71)
                     (list 230 230 230) (list 250 204 21)))
(define (mix a b t) (exact (floor (+ (* a (- 1 t)) (* b t)))))
(define (paint n radius trap)
  (if (>= n limit)
      (let ((t (* 0.34 (pow 2.718281828 (* -18 trap)))))
        (format "~a ~a ~a" (mix 10 250 t) (mix 10 204 t) (mix 11 21 t)))
      (let* ((smooth (- (+ n 1) (/ (log (max 1.001 (log (max radius 1.001)))) (log 2))))
             (v (* smooth 0.105)) (base (exact (floor v)))
             (a (nth palette (mod base 8)))
             (b (nth palette (mod (+ base 1) 8)))
             (t (- v base))
             (brightness (min 1 (+ 0.22 (* 0.045 n)))))
        (format "~a ~a ~a"
          (exact (floor (* brightness (mix (nth a 0) (nth b 0) t))))
          (exact (floor (* brightness (mix (nth a 1) (nth b 1) t))))
          (exact (floor (* brightness (mix (nth a 2) (nth b 2) t))))))))
(define (orbit mode x y n trap)
  (let* ((r (+ (* x x) (* y y)))
         (next-trap (min trap (abs (- (sqrt r) (+ 0.62 (* 0.04 sway)))))))
    (if (or (>= n limit) (> r 100))
        (paint n r next-trap)
        (cond
          ((= mode 0)
           ;; Fold only the imaginary cubic coordinate, then tilt the fold.
           (let ((a (- (* x x x) (* 3 x y y)))
                 (b (- (* 3 x x y) (* y y y))))
             (orbit mode (+ (* 0.92 a) (* -0.18 (abs b)) (+ -0.38 (* 0.035 drift)))
                         (+ (* 0.18 a) (* 0.92 (abs b)) (+ 0.12 (* 0.025 sway))) (+ n 1) next-trap)))
          ((= mode 1)
           ;; Alternate a conjugating shear with a rotated quadratic step.
           (let* ((sign (if (= (mod n 2) 0) 1 -1))
                  (a (- (* x x) (* y y))) (b (* 2 x y sign)))
             (orbit mode (+ (* 0.985 a) (* -0.17 b) (+ -0.69 (* 0.025 drift)))
                         (+ (* 0.17 a) (* 0.985 b) (+ 0.19 (* 0.025 sway))) (+ n 1) next-trap)))
          (else
           ;; A shifted complex pole interrupts the usual quadratic orbit.
           (let* ((u (+ x 0.23 (* 0.025 drift))) (v (- y 0.11 (* 0.025 sway)))
                  (d (max 0.00001 (+ (* u u) (* v v)))))
             (orbit mode (+ (- (* x x) (* y y)) -0.72 (/ (* 0.065 u) d))
                         (+ (* 2 x y) 0.19 (/ (* -0.065 v) d)) (+ n 1) next-trap)))))))
(define (render mode name)
  (let ((span (if (= mode 0) 3.0 3.4)))
    (file/write (str root name ".ppm")
      (str "P3\n" width " " height "\n255\n"
        (string/join
          (map (fn (py)
            (string/join (map (fn (px)
              (orbit mode (* span (- (/ px width) 0.5))
                          (* span (/ height width) (- (/ py height) 0.5)) 0 10))
              (range width)) " ")) (range height)) "\n"))))
  (println (str "Rendered " name)))

(for-each (fn (frame)
  (set! phase (* 6.283185307179586 (/ frame 32)))
  (set! drift (sin phase))
  (set! sway (- (cos phase) 1))
  (render 1 (str "alternating-tide-frames/" (string/pad-left (str frame) 3 "0")))) (range 32))
