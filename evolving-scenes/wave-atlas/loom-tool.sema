;; A small batched SVG drawing library, written in Sema.
;; Native SVG rasterization handles antialiasing; this library controls all
;; geometry, colours, layering, and linear-RGB bloom definitions.
(define palette '((250 204 21) (34 211 238) (185 155 224)))
(define buckets nil)
(define primitive-count 0)
(define culled-count 0)
(define minimum-coordinate 100000.0)
(define maximum-coordinate -100000.0)
(define (q n) (/ (round (* n 1000)) 1000.0))
(define (canvas/reset!)
  (set! buckets (mutable-array/new 36))
  (for-each (fn (_) (mutable-array/push! buckets (mutable-array/new))) (range 36))
  (set! primitive-count 0)
  (set! culled-count 0)
  (set! minimum-coordinate 100000.0)
  (set! maximum-coordinate -100000.0))
(define (canvas/track! x y)
  (assert (and (< (abs x) 10000) (< (abs y) 10000)) "Invalid or unbounded geometry")
  (set! minimum-coordinate (min minimum-coordinate x y))
  (set! maximum-coordinate (max maximum-coordinate x y)))
(define (canvas/path! command level ink)
  (let ((index (+ (* level 3) ink)))
    (mutable-array/push! (mutable-array/get buckets index) command)
    (set! primitive-count (+ primitive-count 1))))
(define (line x y xx yy level ink)
  (canvas/track! x y)
  (canvas/track! xx yy)
  (if (< (+ (abs (- xx x)) (abs (- yy y))) 0.10)
      (set! culled-count (+ culled-count 1))
      (canvas/path! (format "M~a ~aL~a ~a" (q x) (q y) (q xx) (q yy)) level ink)))
(define (circle x y radius level ink)
  (canvas/track! (- x radius) (- y radius))
  (canvas/track! (+ x radius) (+ y radius))
  (if (< radius 0.07)
      (set! culled-count (+ culled-count 1))
      (let ((r (q radius)) (xx (q x)) (yy (q y)))
        (canvas/path! (format "M~a ~aA~a ~a 0 1 0 ~a ~aA~a ~a 0 1 0 ~a ~a"
          (q (+ x radius)) yy r r (q (- x radius)) yy r r (q (+ x radius)) yy) level ink))))
(define (canvas/svg)
  (str "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1920\" height=\"1920\" viewBox=\"0 0 1200 1200\">"
    "<defs><filter id=\"bloom\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\" color-interpolation-filters=\"linearRGB\">"
    "<feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"0.7\" result=\"near\"/>"
    "<feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"2.6\" result=\"middle\"/>"
    "<feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"7\" result=\"far\"/>"
    "<feMerge><feMergeNode in=\"far\"/><feMergeNode in=\"middle\"/><feMergeNode in=\"near\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>"
    "<g id=\"drawing\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">"
    (string/join (map (fn (index)
      (let ((commands (mutable-array/get buckets index)))
        (if (= (mutable-array/length commands) 0) ""
          (let* ((level (quotient index 3)) (ink (mod index 3))
                 (rgb (nth palette (mod (+ ink (quotient level 2)) 3)))
                 (opacity (min 1 (+ 0.52 (* 0.09 level))))
                 (width (max 0.30 (- 0.78 (* 0.065 level)))))
            (format "<path stroke=\"rgb(~a,~a,~a)\" stroke-opacity=\"~a\" stroke-width=\"~a\" d=\"~a\"/>"
              (nth rgb 0) (nth rgb 1) (nth rgb 2) opacity width
              (string/join (mutable-array/->vector commands) "")))))) (range 36)) "")
    "</g></defs><rect width=\"1200\" height=\"1200\" fill=\"#0a0a0b\"/>"
    "<use xlink:href=\"#drawing\" filter=\"url(#bloom)\"/></svg>"))

;; A travelling-wave landscape, drawn as a luminous perspective grid.
(define tau 6.283185307179586)

(define phase 0.0)
(define (surface u v)
  (let* ((r (sqrt (+ (* u u) (* v v))))
         (height (+ (* 34 (sin (- (* 7 r) phase)))
                    (* 25 (sin (+ (* 4 u) (* 3 v) (* 2 phase))))
                    (* 17 (cos (- (* 5 v) (* 3 phase))))))
         (x (* u 310)) (y (* v 310)))
    (list (+ 600 (* 0.82 (- x y))) (+ 610 (* 0.39 (+ x y)) (* -2.0 height)))))
(define (scene frame frames)
  (set! phase (* tau (/ (mod frame frames) frames)))
  (canvas/reset!)
  (for-each (fn (row)
    (let ((v (- (* 2 (/ row 68)) 1)))
      (let loop ((j 1) (prev (surface -1 v)))
        (when (<= j 140)
          (let ((next (surface (- (* 2 (/ j 140)) 1) v)))
            (line (nth prev 0) (nth prev 1) (nth next 0) (nth next 1)
                  3 (mod (quotient row 23) 3))
            (loop (+ j 1) next)))))) (range 69))
  (for-each (fn (column)
    (let ((u (- (* 2 (/ column 44)) 1)))
      (let loop ((j 1) (prev (surface u -1)))
        (when (<= j 110)
          (let ((next (surface u (- (* 2 (/ j 110)) 1))))
            (line (nth prev 0) (nth prev 1) (nth next 0) (nth next 1)
                  0 (mod column 3))
            (loop (+ j 1) next)))))) (range 45))
  ;; Bright points move along the wave field rather than through empty space.
  (for-each (fn (i)
    (let* ((a (+ (* i 2.39996323) phase))
           (p (surface (* 0.85 (sin a)) (* 0.85 (cos (+ (* 2 a) phase))))))
      (circle (nth p 0) (nth p 1) 1.7 5 (mod i 3)))) (range 48))
  (assert (and (> minimum-coordinate 0) (< maximum-coordinate 1200)))
  (canvas/svg))

;; Sema controls geometry, periodic time, bloom, binary streaming, and cleanup.
;; rsvg-convert rasterizes the SVG; FFmpeg supplies image and video codecs.

(define frames 360)
(define mode (or (env "SCENE_MODE") "preview"))
(assert (member mode '("preview" "stream")) "SCENE_MODE must be preview or stream")
(define svg-path ".loom-frame.svg")
(define png-path ".loom-frame.png")
(define first (scene 0 frames))
(assert (= first (scene frames frames)) "Loop endpoints do not match")
(assert (not (= first (scene 90 frames))) "Scene does not evolve")
(file/write "wave-atlas-first.svg" first)
(define started (time-ms))
(define (check result) (assert (= (:exit-code result) 0) (:stderr result)))
(define (raster svg)
  (file/write svg-path svg)
  (check (shell "rsvg-convert" "-w" "3840" "-h" "3840" "-o" png-path svg-path)))
(if (= mode "preview")
  (begin
    (raster first)
    (check (shell "ffmpeg" "-v" "error" "-y" "-i" png-path "-vf" "scale=1920:1920:flags=lanczos" "wave-atlas-still.png")))
  (for-each (fn (frame)
    (let ((svg (scene frame frames)))
      (raster svg)
      (stream/write *stdout* (file/read-bytes png-path))
      (stream/flush *stdout*)
      (file/delete png-path)
      (when (= (mod frame 15) 0)
        (let ((status (json/encode {:frame frame :total frames :elapsed-ms (- (time-ms) started)})))
          (file/write "progress.json" status)
          (stream/write-string *stderr* (str status "\n")))))) (range frames)))
(when (file/exists? svg-path) (file/delete svg-path))
(when (file/exists? png-path) (file/delete png-path))
