;; A small batched SVG drawing library, written in Sema.
;; Native SVG rasterization handles antialiasing; this library controls all
;; geometry, colours, layering, and linear-RGB bloom definitions.
(define palette '((250 204 21) (34 211 238) (185 155 224)))
(define buckets nil)
(define primitive-count 0)
(define culled-count 0)
(define minimum-coordinate 100000.0)
(define maximum-coordinate -100000.0)
(define (q n) (/ (round (* n 1000)) 1000.0))
(define (canvas/reset!)
  (set! buckets (mutable-array/new 36))
  (for-each (fn (_) (mutable-array/push! buckets (mutable-array/new))) (range 36))
  (set! primitive-count 0)
  (set! culled-count 0)
  (set! minimum-coordinate 100000.0)
  (set! maximum-coordinate -100000.0))
(define (canvas/track! x y)
  (assert (and (< (abs x) 10000) (< (abs y) 10000)) "Invalid or unbounded geometry")
  (set! minimum-coordinate (min minimum-coordinate x y))
  (set! maximum-coordinate (max maximum-coordinate x y)))
(define (canvas/path! command level ink)
  (let ((index (+ (* level 3) ink)))
    (mutable-array/push! (mutable-array/get buckets index) command)
    (set! primitive-count (+ primitive-count 1))))
(define (line x y xx yy level ink)
  (canvas/track! x y)
  (canvas/track! xx yy)
  (if (< (+ (abs (- xx x)) (abs (- yy y))) 0.10)
      (set! culled-count (+ culled-count 1))
      (canvas/path! (format "M~a ~aL~a ~a" (q x) (q y) (q xx) (q yy)) level ink)))
(define (circle x y radius level ink)
  (canvas/track! (- x radius) (- y radius))
  (canvas/track! (+ x radius) (+ y radius))
  (if (< radius 0.07)
      (set! culled-count (+ culled-count 1))
      (let ((r (q radius)) (xx (q x)) (yy (q y)))
        (canvas/path! (format "M~a ~aA~a ~a 0 1 0 ~a ~aA~a ~a 0 1 0 ~a ~a"
          (q (+ x radius)) yy r r (q (- x radius)) yy r r (q (+ x radius)) yy) level ink))))
(define (canvas/svg)
  (str "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1920\" height=\"1920\" viewBox=\"0 0 1200 1200\">"
    "<defs><filter id=\"bloom\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\" color-interpolation-filters=\"linearRGB\">"
    "<feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"0.7\" result=\"near\"/>"
    "<feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"2.6\" result=\"middle\"/>"
    "<feGaussianBlur in=\"SourceGraphic\" stdDeviation=\"7\" result=\"far\"/>"
    "<feMerge><feMergeNode in=\"far\"/><feMergeNode in=\"middle\"/><feMergeNode in=\"near\"/><feMergeNode in=\"SourceGraphic\"/></feMerge></filter>"
    "<g id=\"drawing\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">"
    (string/join (map (fn (index)
      (let ((commands (mutable-array/get buckets index)))
        (if (= (mutable-array/length commands) 0) ""
          (let* ((level (quotient index 3)) (ink (mod index 3))
                 (rgb (nth palette (mod (+ ink (quotient level 2)) 3)))
                 (opacity (min 1 (+ 0.52 (* 0.09 level))))
                 (width (max 0.30 (- 0.78 (* 0.065 level)))))
            (format "<path stroke=\"rgb(~a,~a,~a)\" stroke-opacity=\"~a\" stroke-width=\"~a\" d=\"~a\"/>"
              (nth rgb 0) (nth rgb 1) (nth rgb 2) opacity width
              (string/join (mutable-array/->vector commands) "")))))) (range 36)) "")
    "</g></defs><rect width=\"1200\" height=\"1200\" fill=\"#0a0a0b\"/>"
    "<use xlink:href=\"#drawing\" filter=\"url(#bloom)\"/></svg>"))

;; Animated recursive geometry, generated by prepare-native.sema.
;; Drawing functions come from svg-canvas.sema.
;; wave and sway are periodic parameters set by render-native.sema.
;; Each five-port ring remembers its ancestral phase. The next phase depends
;; on both port index and the incoming phase; copies are not identically oriented.
(define (lace x y r phase depth level)
  (circle x y (* r 0.51) level 0)
  (when (> depth 0)
    (for-each (fn (port)
      (let* ((a (+ phase (* tau (/ port 5))))
             (b (+ a 0.44 (* 0.16 (sin (+ phase port)))))
             (xx (+ x (* r (cos a)))) (yy (+ y (* r (sin a))))
             (ex (+ x (* r 0.51 (cos b)))) (ey (+ y (* r 0.51 (sin b))))
             (memory (+ (* 0.71 phase) (* 0.93 port) (* 0.31 (sin (* 2 phase))) (* 0.065 wave (- port 2))))
             (scale (+ 0.285 (* 0.025 (cos memory)))))
        (line ex ey xx yy level (mod port 3))
        (lace xx yy (* r scale) memory (- depth 1) (+ level 1)))) (range 5))))


;; A curved three-port motif carries a signed memory of previous turns.
;; Memory affects curvature, rotation, and copy size; paired branches reverse it.
(define (braid x y r angle memory depth level)
  (for-each (fn (k)
    (let* ((a (+ angle (* tau (/ k 3))))
           (b (+ angle (* tau (/ (+ k 1) 3))))
           (bend (+ 0.35 (* 0.22 (sin memory)) (* 0.04 sway)))
           (segments (if (< level 2) 96 (if (< level 4) 32 12))))
      (for-each (fn (j)
        (let* ((t (/ j segments)) (tt (/ (+ j 1) segments))
               (u (+ a (* (- b a) t))) (v (+ a (* (- b a) tt)))
               (rr (* r (+ 0.7 (* bend (sin (* 3.14159265359 t))))))
               (ss (* r (+ 0.7 (* bend (sin (* 3.14159265359 tt)))))))
          (line (+ x (* rr (cos u))) (+ y (* rr (sin u)))
                (+ x (* ss (cos v))) (+ y (* ss (sin v))) level k))) (range segments))
      (when (> depth 0)
        (let* ((sign (if (= k 1) -1 1))
               (next (+ (* sign 0.63 memory) (- k 1) 0.27 (* 0.085 wave sign)))
               (turn (+ a (* 0.47 (sin next)))))
          (braid (+ x (* r 0.72 (cos a))) (+ y (* r 0.72 (sin a)))
                 (* r (+ 0.43 (* 0.025 (cos next)))) turn next
                 (- depth 1) (+ level 1)))))) (range 3)))


;; Four curved descendants inherit a phase generated from the entire path.
;; The contraction bounds keep the recursively generated geometry finite.
(define (coral x y length angle phase depth level)
  (let* ((turn (* 0.48 (sin phase)))
         (segments (if (< level 2) 48 (if (< level 4) 16 8)))
         (xx (+ x (* length (cos (+ angle turn)))))
         (yy (+ y (* length (sin (+ angle turn))))))
    (for-each (fn (j)
      (let* ((t (/ j segments)) (u (/ (+ j 1) segments))
             (a (+ angle (* turn t))) (b (+ angle (* turn u))))
        (line (+ x (* length t (cos a))) (+ y (* length t (sin a)))
              (+ x (* length u (cos b))) (+ y (* length u (sin b))) level (mod level 3)))) (range segments))
    (when (> depth 0)
      (for-each (fn (port)
        (let* ((next (+ (* 0.81 phase) (* 1.17 (- port 1.5)) (* 0.25 (sin phase)) (* 0.08 wave (- port 1.5))))
               (spread (+ (* 0.49 (- port 1.5)) (* 0.22 (sin next)))))
          (coral xx yy (* length (+ 0.47 (* 0.035 (cos next))))
                 (+ angle turn spread) next (- depth 1) (+ level 1)))) (range 4)))))

;; A Sema-only custom animation tool. Requires native rsvg-convert and FFmpeg.
;; Geometry, SVG rendering instructions, bloom, timing, orchestration, binary
;; streaming, cleanup, and verification are all implemented in Sema.
(define tau 6.283185307179586)
(define wave 0.0)
(define sway 0.0)


(define frames (string/to-number (or (env "FRACTAL_FRAMES") "240")))
(assert (and (integer? frames) (>= frames 4) (<= frames 3600)) "FRACTAL_FRAMES must be an integer between 4 and 3600")
(define fps 60)
(define name (or (env "FRACTAL_NAME") "signed-braid"))
(define mode (or (env "FRACTAL_MODE") "preview"))
(assert (member name '("address-lace" "signed-braid" "phase-coral")) "Unknown FRACTAL_NAME")
(assert (member mode '("preview" "stream")) "FRACTAL_MODE must be preview or stream")
(define output (str name "-1920-60fps-loop.mp4"))
(define frame-svg (str "." name "-frame.svg"))
(define frame-png (str "." name "-frame.png"))
(define fifo (str "." name "-video.pipe"))
(define started (time-ms))
(define total-primitives 0)
(define total-svg-bytes 0)
(define (check result context)
  (assert (= (:exit-code result) 0) (str context ": " (:stderr result))))
(define (geometry frame)
  (let ((theta (* tau (/ (mod frame frames) frames))))
    (set! wave (sin theta))
    (set! sway (- (cos theta) 1)))
  (canvas/reset!)
  (cond
    ((= name "address-lace") (lace 600 600 315 (+ -1.57079632679 (* 0.22 wave)) 6 0))
    ((= name "signed-braid") (braid 600 600 355 (+ -1.57079632679 (* 0.12 sway)) (+ 0.6 (* 0.38 wave)) 6 0))
    ((= name "phase-coral")
      (for-each (fn (arm)
        (coral 600 600 190 (+ -1.57079632679 (* tau (/ arm 7)) (* 0.10 sway))
               (+ 0.41 (* arm 0.73) (* 0.32 wave)) 5 0)) (range 7)))
    (else (error (str "Unknown construction: " name))))
  (assert (and (> minimum-coordinate 0) (< maximum-coordinate 1200)) "Camera would crop geometry")
  (canvas/svg))
(define (raster svg)
  (file/write frame-svg svg)
  (check (shell "rsvg-convert" "-w" "3840" "-h" "3840" "-o" frame-png frame-svg) "SVG rasterization"))
(define first-svg (geometry 0))
(define first-count primitive-count)
(define first-culled culled-count)
(define last-svg (geometry frames))
(assert (= first-svg last-svg) "Loop endpoints differ")
(assert (not (= first-svg (geometry (quotient frames 4)))) "Animation does not move")
(file/write (str name "-loop-first.svg") first-svg)
(define (progress text)
  (stream/write-string *stderr* (str text "\n"))
  (stream/flush *stderr*))
(progress (format "~a: ~a paths/frame, ~a subpixel paths culled; exact loop endpoints verified" name first-count first-culled))

(if (= mode "preview")
  (begin
    (raster first-svg)
    (check (shell "ffmpeg" "-v" "error" "-y" "-i" frame-png "-vf" "scale=1920:1920:flags=lanczos" (str name "-1920-bloom.png")) "Preview PNG")
    (progress (format "Preview finished in ~a ms" (- (time-ms) started))))
  (begin
    ;; Named pipes are deliberately rejected by stream/open-output. CLI binary
    ;; stdout is supported, so the Sema coordinator connects it to FFmpeg.
    (for-each (fn (frame)
      (let* ((svg (geometry frame)) (count primitive-count))
        (set! total-primitives (+ total-primitives count))
        (set! total-svg-bytes (+ total-svg-bytes (string/length svg)))
        (raster svg)
        (stream/write *stdout* (file/read-bytes frame-png))
        (stream/flush *stdout*)
        (when (= frame 0)
          (check (shell "ffmpeg" "-v" "error" "-y" "-i" frame-png "-vf" "scale=1920:1920:flags=lanczos" (str name "-1920-bloom.png")) "Preview PNG"))
        (file/delete frame-png)
        (when (= (mod frame 10) 0)
          (progress (format "~a: frame ~a/~a, elapsed ~a seconds" name frame frames (/ (- (time-ms) started) 1000.0)))
          (file/write (str name "-progress.json") (json/encode {:frame frame :total frames :elapsed-ms (- (time-ms) started)}))))) (range frames))
    (file/write (str name "-sema-generation.json") (json/encode-pretty
      {:name name :language "Sema" :frames frames :fps fps :resolution [1920 1920]
       :raster-resolution [3840 3840] :loop-endpoints-identical #t
       :bloom "three-scale, linearRGB" :paths-generated total-primitives
       :svg-bytes-generated total-svg-bytes :elapsed-ms (- (time-ms) started)
       :native-tools ["rsvg-convert" "ffmpeg" "ffprobe"]}))
    (progress (str "Generated all frames for " output))))
(when (file/exists? frame-svg) (file/delete frame-svg))
(when (file/exists? frame-png) (file/delete frame-png))
(when (file/exists? fifo) (check (shell "rm" "-f" fifo) "Remove obsolete encoder pipe"))
