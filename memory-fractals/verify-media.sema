;; Inspect GIF headers and loop extensions directly with Sema bytevectors.
;; FFmpeg performs a strict full decode of each completed MP4.
(define selection (env "FRACTAL_NAME"))
(define names (if selection (list selection) '("address-lace" "signed-braid" "phase-coral")))
(define (u16 bytes offset)
  (+ (bytevector-u8-ref bytes offset) (* 256 (bytevector-u8-ref bytes (+ offset 1)))))
(define results
  (map (fn (name)
    (let* ((video (str name "-1920-60fps-loop.mp4"))
           (preview (str name "-bloom-preview.gif"))
           (gif (file/read-bytes preview))
           (loop-offset (bytes/find gif "NETSCAPE2.0"))
           (decode (shell "ffmpeg" "-v" "error" "-xerror" "-i" video "-f" "null" "-")))
      (assert (= (:exit-code decode) 0) (str "Invalid video: " (:stderr decode)))
      (assert (= (bytes/find gif "GIF89a") 0) "Invalid GIF header")
      (assert loop-offset "Missing GIF loop extension")
      (assert (= (u16 gif (+ loop-offset 13)) 0) "GIF is not configured to repeat indefinitely")
      (assert (= (u16 gif 6) 640) "Wrong GIF width")
      (assert (= (u16 gif 8) 640) "Wrong GIF height")
      (let ((report {:name name :mp4-bytes (:size (file/info video))
                    :gif-bytes (bytevector-length gif)
                    :gif-loops-forever #t :strict-video-decode-passed #t}))
        (println (json/encode report))
        report))) names))
(file/write "media-integrity.json" (json/encode-pretty results))
