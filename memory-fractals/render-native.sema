;; A Sema-only custom animation tool. Requires native rsvg-convert and FFmpeg.
;; Geometry, SVG rendering instructions, bloom, timing, orchestration, binary
;; streaming, cleanup, and verification are all implemented in Sema.
(define tau 6.283185307179586)
(define wave 0.0)
(define sway 0.0)
(load "svg-canvas.sema")
(load "animated-geometry.sema")
(define frames (string/to-number (or (env "FRACTAL_FRAMES") "240")))
(assert (and (integer? frames) (>= frames 4) (<= frames 3600)) "FRACTAL_FRAMES must be an integer between 4 and 3600")
(define fps 60)
(define name (or (env "FRACTAL_NAME") "signed-braid"))
(define mode (or (env "FRACTAL_MODE") "preview"))
(assert (member name '("address-lace" "signed-braid" "phase-coral")) "Unknown FRACTAL_NAME")
(assert (member mode '("preview" "stream")) "FRACTAL_MODE must be preview or stream")
(define output (str name "-1920-60fps-loop.mp4"))
(define frame-svg (str "." name "-frame.svg"))
(define frame-png (str "." name "-frame.png"))
(define fifo (str "." name "-video.pipe"))
(define started (time-ms))
(define total-primitives 0)
(define total-svg-bytes 0)
(define (check result context)
  (assert (= (:exit-code result) 0) (str context ": " (:stderr result))))
(define (geometry frame)
  (let ((theta (* tau (/ (mod frame frames) frames))))
    (set! wave (sin theta))
    (set! sway (- (cos theta) 1)))
  (canvas/reset!)
  (cond
    ((= name "address-lace") (lace 600 600 315 (+ -1.57079632679 (* 0.22 wave)) 6 0))
    ((= name "signed-braid") (braid 600 600 355 (+ -1.57079632679 (* 0.12 sway)) (+ 0.6 (* 0.38 wave)) 6 0))
    ((= name "phase-coral")
      (for-each (fn (arm)
        (coral 600 600 190 (+ -1.57079632679 (* tau (/ arm 7)) (* 0.10 sway))
               (+ 0.41 (* arm 0.73) (* 0.32 wave)) 5 0)) (range 7)))
    (else (error (str "Unknown construction: " name))))
  (assert (and (> minimum-coordinate 0) (< maximum-coordinate 1200)) "Camera would crop geometry")
  (canvas/svg))
(define (raster svg)
  (file/write frame-svg svg)
  (check (shell "rsvg-convert" "-w" "3840" "-h" "3840" "-o" frame-png frame-svg) "SVG rasterization"))
(define first-svg (geometry 0))
(define first-count primitive-count)
(define first-culled culled-count)
(define last-svg (geometry frames))
(assert (= first-svg last-svg) "Loop endpoints differ")
(assert (not (= first-svg (geometry (quotient frames 4)))) "Animation does not move")
(file/write (str name "-loop-first.svg") first-svg)
(define (progress text)
  (stream/write-string *stderr* (str text "\n"))
  (stream/flush *stderr*))
(progress (format "~a: ~a paths/frame, ~a subpixel paths culled; exact loop endpoints verified" name first-count first-culled))

(if (= mode "preview")
  (begin
    (raster first-svg)
    (check (shell "ffmpeg" "-v" "error" "-y" "-i" frame-png "-vf" "scale=1920:1920:flags=lanczos" (str name "-1920-bloom.png")) "Preview PNG")
    (progress (format "Preview finished in ~a ms" (- (time-ms) started))))
  (begin
    ;; Named pipes are deliberately rejected by stream/open-output. CLI binary
    ;; stdout is supported, so the Sema coordinator connects it to FFmpeg.
    (for-each (fn (frame)
      (let* ((svg (geometry frame)) (count primitive-count))
        (set! total-primitives (+ total-primitives count))
        (set! total-svg-bytes (+ total-svg-bytes (string/length svg)))
        (raster svg)
        (stream/write *stdout* (file/read-bytes frame-png))
        (stream/flush *stdout*)
        (when (= frame 0)
          (check (shell "ffmpeg" "-v" "error" "-y" "-i" frame-png "-vf" "scale=1920:1920:flags=lanczos" (str name "-1920-bloom.png")) "Preview PNG"))
        (file/delete frame-png)
        (when (= (mod frame 10) 0)
          (progress (format "~a: frame ~a/~a, elapsed ~a seconds" name frame frames (/ (- (time-ms) started) 1000.0)))
          (file/write (str name "-progress.json") (json/encode {:frame frame :total frames :elapsed-ms (- (time-ms) started)}))))) (range frames))
    (file/write (str name "-sema-generation.json") (json/encode-pretty
      {:name name :language "Sema" :frames frames :fps fps :resolution [1920 1920]
       :raster-resolution [3840 3840] :loop-endpoints-identical #t
       :bloom "three-scale, linearRGB" :paths-generated total-primitives
       :svg-bytes-generated total-svg-bytes :elapsed-ms (- (time-ms) started)
       :native-tools ["rsvg-convert" "ffmpeg" "ffprobe"]}))
    (progress (str "Generated all frames for " output))))
(when (file/exists? frame-svg) (file/delete frame-svg))
(when (file/exists? frame-png) (file/delete frame-png))
(when (file/exists? fifo) (check (shell "rm" "-f" fifo) "Remove obsolete encoder pipe"))
