;; Exercise deep recursion, mutable buffers, formatting, and SVG batching.
;; No rasterizer or encoder is involved in these measurements.
(define tau 6.283185307179586)
(define wave 0.0)
(define sway 0.0)
(load "svg-canvas.sema")
(load "animated-geometry.sema")
(define (measure label thunk)
  (canvas/reset!)
  (let ((started (time-ms)))
    (thunk)
    (let* ((generated (time-ms)) (svg (canvas/svg)) (finished (time-ms))
           (report {:case label :paths primitive-count :culled culled-count
             :attempted-paths (+ primitive-count culled-count)
             :svg-bytes (string/length svg) :generation-ms (- generated started)
             :batching-ms (- finished generated)
             :minimum-coordinate minimum-coordinate :maximum-coordinate maximum-coordinate}))
      (assert (> primitive-count 1000) "Empty stress result")
      (assert (and (> minimum-coordinate 0) (< maximum-coordinate 1200)) "Unbounded stress geometry")
      (println (json/encode report))
      report)))
(define results
  (list
    (measure "lace-depth-7" (fn () (lace 600 600 315 -1.57079632679 7 0)))
    (measure "lace-depth-8" (fn () (lace 600 600 315 -1.57079632679 8 0)))
    (measure "braid-depth-7" (fn () (braid 600 600 355 -1.57079632679 0.6 7 0)))
    (measure "coral-depth-6" (fn ()
      (for-each (fn (arm) (coral 600 600 190 (+ -1.57079632679 (* tau (/ arm 7)))
        (+ 0.41 (* arm 0.73)) 6 0)) (range 7))))
    (measure "coral-depth-7" (fn ()
      (for-each (fn (arm) (coral 600 600 190 (+ -1.57079632679 (* tau (/ arm 7)))
        (+ 0.41 (* arm 0.73)) 7 0)) (range 7))))))
(file/write "sema-geometry-stress.json" (json/encode-pretty results))
(canvas/reset!)
(println "Sema geometry stress checks passed.")
