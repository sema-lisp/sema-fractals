;; Build the animated geometry library using Sema string processing.
(define source (file/read "experiments.sema"))
(define geometry (str ";; Animated recursive geometry, generated by prepare-native.sema.\n"
  ";; Drawing functions come from svg-canvas.sema.\n"
  ";; wave and sway are periodic parameters set by render-native.sema.\n"
  ";; Each five-port" (nth (string/split source ";; Each five-port") 1)))
(set! geometry (nth (string/split geometry "(for-each (fn (arm)") 0))
(set! geometry (string/replace geometry "(lace 600 600 315 -1.57079632679 6 0)\n(save \"address-lace\")" ""))
(set! geometry (string/replace geometry "(braid 600 600 355 -1.57079632679 0.6 6 0)\n(save \"signed-braid\")" ""))
(set! geometry (string/replace geometry "(* 0.31 (sin (* 2 phase)))" "(* 0.31 (sin (* 2 phase))) (* 0.065 wave (- port 2))"))
(set! geometry (string/replace geometry "(bend (+ 0.35 (* 0.22 (sin memory)))))" "(bend (+ 0.35 (* 0.22 (sin memory)) (* 0.04 sway)))\n           (segments (if (< level 2) 96 (if (< level 4) 32 12))))"))
(set! geometry (string/replace geometry "(/ j 12)" "(/ j segments)"))
(set! geometry (string/replace geometry "(/ (+ j 1) 12)" "(/ (+ j 1) segments)"))
(set! geometry (string/replace geometry "(range 12)" "(range segments)"))
(set! geometry (string/replace geometry "(- k 1) 0.27)" "(- k 1) 0.27 (* 0.085 wave sign))"))
(set! geometry (string/replace geometry "(turn (* 0.48 (sin phase)))" "(turn (* 0.48 (sin phase)))\n         (segments (if (< level 2) 48 (if (< level 4) 16 8)))"))
(set! geometry (string/replace geometry "(/ j 8)" "(/ j segments)"))
(set! geometry (string/replace geometry "(/ (+ j 1) 8)" "(/ (+ j 1) segments)"))
(set! geometry (string/replace geometry "(range 8)" "(range segments)"))
(set! geometry (string/replace geometry "(* 0.25 (sin phase)))" "(* 0.25 (sin phase)) (* 0.08 wave (- port 1.5)))"))
(file/write "animated-geometry.sema" geometry)
(println "Generated animated-geometry.sema entirely with Sema.")
