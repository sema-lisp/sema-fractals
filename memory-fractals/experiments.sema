;; Custom address-dependent recursive constructions. Geometry is generated in Sema.
;; These are experimental fractal artworks, not claims of mathematical priority.
(define root "./")
(define tau 6.283185307179586)
(define records '())
(define (line x y xx yy level ink)
  (set! records (cons (format "L ~a ~a ~a ~a ~a ~a" x y xx yy level ink) records)))
(define (circle x y radius level ink)
  (set! records (cons (format "C ~a ~a ~a 0 ~a ~a" x y radius level ink) records)))
(define (save name)
  (file/write (str root name ".geometry") (string/join (reverse records) "\n"))
  (println (format "~a: ~a primitives" name (length records)))
  (set! records '()))

;; Each five-port ring remembers its ancestral phase. The next phase depends
;; on both port index and the incoming phase; copies are not identically oriented.
(define (lace x y r phase depth level)
  (circle x y (* r 0.51) level 0)
  (when (> depth 0)
    (for-each (fn (port)
      (let* ((a (+ phase (* tau (/ port 5))))
             (b (+ a 0.44 (* 0.16 (sin (+ phase port)))))
             (xx (+ x (* r (cos a)))) (yy (+ y (* r (sin a))))
             (ex (+ x (* r 0.51 (cos b)))) (ey (+ y (* r 0.51 (sin b))))
             (memory (+ (* 0.71 phase) (* 0.93 port) (* 0.31 (sin (* 2 phase)))))
             (scale (+ 0.285 (* 0.025 (cos memory)))))
        (line ex ey xx yy level (mod port 3))
        (lace xx yy (* r scale) memory (- depth 1) (+ level 1)))) (range 5))))
(lace 600 600 315 -1.57079632679 6 0)
(save "address-lace")

;; A curved three-port motif carries a signed memory of previous turns.
;; Memory affects curvature, rotation, and copy size; paired branches reverse it.
(define (braid x y r angle memory depth level)
  (for-each (fn (k)
    (let* ((a (+ angle (* tau (/ k 3))))
           (b (+ angle (* tau (/ (+ k 1) 3))))
           (bend (+ 0.35 (* 0.22 (sin memory)))))
      (for-each (fn (j)
        (let* ((t (/ j 12)) (tt (/ (+ j 1) 12))
               (u (+ a (* (- b a) t))) (v (+ a (* (- b a) tt)))
               (rr (* r (+ 0.7 (* bend (sin (* 3.14159265359 t))))))
               (ss (* r (+ 0.7 (* bend (sin (* 3.14159265359 tt)))))))
          (line (+ x (* rr (cos u))) (+ y (* rr (sin u)))
                (+ x (* ss (cos v))) (+ y (* ss (sin v))) level k))) (range 12))
      (when (> depth 0)
        (let* ((sign (if (= k 1) -1 1))
               (next (+ (* sign 0.63 memory) (- k 1) 0.27))
               (turn (+ a (* 0.47 (sin next)))))
          (braid (+ x (* r 0.72 (cos a))) (+ y (* r 0.72 (sin a)))
                 (* r (+ 0.43 (* 0.025 (cos next)))) turn next
                 (- depth 1) (+ level 1)))))) (range 3)))
(braid 600 600 355 -1.57079632679 0.6 6 0)
(save "signed-braid")

;; Four curved descendants inherit a phase generated from the entire path.
;; The contraction bounds keep the recursively generated geometry finite.
(define (coral x y length angle phase depth level)
  (let* ((turn (* 0.48 (sin phase)))
         (xx (+ x (* length (cos (+ angle turn)))))
         (yy (+ y (* length (sin (+ angle turn))))))
    (for-each (fn (j)
      (let* ((t (/ j 8)) (u (/ (+ j 1) 8))
             (a (+ angle (* turn t))) (b (+ angle (* turn u))))
        (line (+ x (* length t (cos a))) (+ y (* length t (sin a)))
              (+ x (* length u (cos b))) (+ y (* length u (sin b))) level (mod level 3)))) (range 8))
    (when (> depth 0)
      (for-each (fn (port)
        (let* ((next (+ (* 0.81 phase) (* 1.17 (- port 1.5)) (* 0.25 (sin phase))))
               (spread (+ (* 0.49 (- port 1.5)) (* 0.22 (sin next)))))
          (coral xx yy (* length (+ 0.47 (* 0.035 (cos next))))
                 (+ angle turn spread) next (- depth 1) (+ level 1)))) (range 4)))))
(for-each (fn (arm)
  (coral 600 600 190 (+ -1.57079632679 (* tau (/ arm 7)))
         (+ 0.41 (* arm 0.73)) 5 0)) (range 7))
(save "phase-coral")
